{
  "appId": "com.guestflow.pms",
  "productName": "GuestFlow PMS",
  "electronVersion": "41.3.0",
  "directories": {
    "output": "dist"
  },
  "files": [
    "electron/main.js",
    "electron/server-manager.js",
    "electron/package.json",
    "electron/icon-512.png",
    ".next/**/*",
    "public/**/*",
    "prisma/schema.prisma",
    "node_modules/**/*",
    "package.json",
    "!node_modules/.cache/**/*",
    "!node_modules/@next/swc-*/**/*",
    "!**/*.map",
    "!**/test/**/*",
    "!**/__tests__/**/*",
    "!**/*.test.*",
    "!**/*.spec.*"
  ],
  "extraResources": [
    {
      "from": "dev.db",
      "to": "app/dev.db",
      "filter": ["**/*"]
    }
  ],
  "npmRebuild": false,
  "asar": true,
  "win": {
    "icon": "electron/icon-512.png",
    "artifactName": "GuestFlow-PMS-Setup.exe",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "mac": {
    "icon": "electron/icon-512.png",
    "artifactName": "GuestFlow-PMS.dmg",
    "target": ["dmg"],
    "category": "public.app-category.business"
  },
  "dmg": {
    "contents": [
      { "x": 410, "y": 150, "type": "link", "path": "/Applications" },
      { "x": 130, "y": 150, "type": "file" }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "GuestFlow PMS",
    "installerIcon": "electron/icon-512.png",
    "uninstallerIcon": "electron/icon-512.png",
    "installerHeaderIcon": "electron/icon-512.png",
    "runAfterFinish": true
  }
}
