{
  "appId": "com.guestflow.pms",
  "productName": "GuestFlow PMS",
  "electronVersion": "41.3.0",
  "directories": {
    "output": "../dist"
  },
  "files": [
    "main.js",
    "icon-512.png"
  ],
  "npmRebuild": false,
  "win": {
    "icon": "icon-512.png",
    "artifactName": "guestflow-pms.exe",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "mac": {
    "icon": "icon-512.png",
    "artifactName": "guestflow-pms.dmg",
    "target": [
      "dmg"
    ],
    "category": "public.app-category.business"
  },
  "dmg": {
    "contents": [
      {
        "x": 410,
        "y": 150,
        "type": "link",
        "path": "/Applications"
      },
      {
        "x": 130,
        "y": 150,
        "type": "file"
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "GuestFlow PMS"
  }
}
