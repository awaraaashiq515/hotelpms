{
  "name": "gustflow",
  "version": "0.1.0",
  "description": "GuestFlow PMS Desktop Application",
  "author": "GuestFlow PMS",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/awaraaashiq515/hotelpms.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"next dev --webpack\" \"npx tsx src/scripts/walkie-talkie-socket.ts\" \"node scripts/backup-manager.js start 10\"",
    "build": "npx prisma generate && cross-env NODE_OPTIONS='--max-old-space-size=2048' next build",
    "export": "next build && next export",
    "start": "concurrently \"next start\" \"WALKIE_PORT=5005 npx tsx src/scripts/walkie-talkie-socket.ts\"",
    "backup": "node scripts/backup-manager.js backup",
    "backup:start": "node scripts/backup-manager.js start 60",
    "backup:list": "node scripts/backup-manager.js list",
    "backup:status": "node scripts/backup-manager.js status",
    "lint": "eslint",
    "electron-dev": "concurrently \"next dev --webpack\" \"wait-on http://localhost:3000 && electron electron/main.js\"",
    "electron-build": "node -e \"const fs = require('fs'); if (!fs.existsSync('dev.db')) fs.writeFileSync('dev.db', '');\" && npm run build && electron-builder --config electron-builder.json --publish never",
    "build-mac": "node -e \"const fs = require('fs'); if (!fs.existsSync('dev.db')) fs.writeFileSync('dev.db', '');\" && npm run build && electron-builder --config electron-builder.json --mac --publish never",
    "build-win": "node -e \"const fs = require('fs'); if (!fs.existsSync('dev.db')) fs.writeFileSync('dev.db', '');\" && npm run build && electron-builder --config electron-builder.json --win --x64 --publish never",
    "offline:test": "OFFLINE_MODE=true next dev --webpack",
    "offline:dev": "OFFLINE_MODE=true next dev --webpack",
    "setup:offline": "node scripts/setup-offline.js",
    "offline:backup": "node scripts/offline-backup.js backup",
    "test": "npm run test:all",
    "test:unit": "TEST_DB=1 vitest run tests/unit",
    "test:int": "TEST_DB=1 vitest run tests/integration",
    "test:regression": "mkdir -p tests/reports && TEST_DB=1 vitest run --reporter=json --outputFile=tests/reports/vitest-results.json tests/unit tests/integration tests/regression && node scripts/regression-report.mjs",
    "test:all": "npm run test:regression",
    "test:report": "node scripts/regression-report.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.4.1",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^5.22.0",
    "@tensorflow-models/mobilenet": "^2.1.1",
    "@tensorflow/tfjs": "^4.22.0",
    "agora-rtc-sdk-ng": "^4.24.4",
    "agora-token": "^2.0.3",
    "bcryptjs": "^3.0.3",
    "capacitor-native-settings": "^8.1.0",
    "clsx": "^2.1.1",
    "cordova-plugin-android-permissions": "^1.1.5",
    "cordova-plugin-bluetooth-serial": "^0.4.7",
    "date-fns": "^4.1.0",
    "firebase-admin": "^12.1.1",
    "framer-motion": "^12.38.0",
    "googleapis": "^188.0.0",
    "imap": "^0.8.19",
    "jose": "^6.2.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.577.0",
    "mailparser": "^3.9.14",
    "next": "16.1.6",
    "nodemailer": "^8.0.5",
    "otpauth": "^9.5.1",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "qz-tray": "^2.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "recharts": "^3.8.1",
    "serialport": "^13.0.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/imap": "^0.8.43",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.19.37",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/qz-tray": "^2.2.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/socket.io": "^3.0.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^5.22.0",
    "supertest": "^7.3.2",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^4.1.12",
    "wait-on": "^9.0.5"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "optionalDependencies": {
    "@next/swc-linux-x64-gnu": "^16.2.10",
    "@next/swc-linux-x64-musl": "^16.2.10"
  }
}
